{
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    ".agents/**",
    ".git/**",
    ".venv/**",
    "venv/**"
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD033": {
      "allowed_elements": [],
      "table_allowed_elements": [
        "br"
      ]
    },
    "MD060": false
  }
}
