# ==============================================================================
# Environment Configuration Template (.env.example)
# Parking Management Backend (Django 6.1.2 + PostgreSQL 18.6)
# NOTE: Copy this file to .env and fill in real values. Never commit .env to Git!
# ==============================================================================

# Django Core Settings (provide a runtime random value in .env)
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# PostgreSQL Database Configuration (provide a runtime random password in .env)
POSTGRES_DB=parking_db
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Database Connection Pool & SSL Settings
DB_CONN_MAX_AGE=60
DB_SSLMODE=prefer

# CORS & CSRF Configuration (SPA Integration per ADR-0004)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production Security Flags (Optional Overrides for config/settings/production.py)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
