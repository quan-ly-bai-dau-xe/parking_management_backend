# ==============================================================================
# Environment Configuration Template (.env.example)
# Parking Management Backend (Django 6.1.2 + PostgreSQL 18.6)
# NOTE: Copy this file to .env and fill in real values. Never commit .env to Git!
# ==============================================================================

# Django Core Settings (provide a runtime random value in .env)
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,::1

# PostgreSQL Database Configuration (provide a runtime random password in .env)
POSTGRES_DB=parking_db
POSTGRES_USER=parking_user
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Database Connection Pool & SSL Settings
DB_CONN_MAX_AGE=60
DB_POOL_ENABLE=0
DB_SSLMODE=prefer

# Gunicorn HTTP Server Tuning (H3)
# Set GUNICORN_MAX_REQUESTS=0 to disable request-count restarts and eliminate restart storms.
GUNICORN_WORKERS=4
GUNICORN_THREADS=6
GUNICORN_MAX_REQUESTS=0
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_TIMEOUT=30
GUNICORN_MEMORY_LIMIT_MB=1536

# ==============================================================================
# OCR Engine, Model Directory & Accuracy Tunables (J3, J6)
# ==============================================================================
PARKING_OCR_ENGINE=fast_alpr
PARKING_OCR_MODELS_DIR=/app/models/ocr
OCR_MODELS_DIR=/app/models/ocr

# Minimum character confidence (%) required for automated approval (AUTO).
# Calibrated to 90.0% to achieve wrong-in-AUTO <= 1.0% and coverage >= 90.0%.
PARKING_OCR_AUTO_CONFIDENCE_THRESHOLD=90.0

# Adaptive Dual-OCR Ensemble: single-pass bypass if Model 1 confidence is high.
PARKING_OCR_ADAPTIVE_ENSEMBLE=1
PARKING_OCR_ADAPTIVE_THRESHOLD=94.0
PARKING_OCR_LEADING_CHAR_THRESHOLD=99.2
PARKING_OCR_ADAPTIVE_AVG_THRESHOLD=96.0

# Crop margin padding (pixels) around bounding box before OCR. Safe range: 0-20.
PARKING_OCR_CROP_MARGIN=4

# OCR Concurrency Gate & Backpressure (A4 / H3)
PARKING_OCR_CONCURRENCY_LIMIT=4
PARKING_OCR_QUEUE_TIMEOUT=2.0
# Retry-After header duration (seconds) returned upon HTTP 503 overload.
PARKING_OCR_RETRY_AFTER=3

# ==============================================================================
# Review Policy Secondary Signal Thresholds (H7, J6)
# ==============================================================================
PARKING_REVIEW_DETECTOR_CONF_THRESHOLD=80.0
PARKING_REVIEW_MIN_ASPECT_RATIO=1.3
PARKING_REVIEW_MAX_ASPECT_RATIO=6.0
PARKING_REVIEW_MIN_SHARPNESS=30.0

# ==============================================================================
# Upload & Storage Domain Limits (J6)
# ==============================================================================
MAX_IMAGE_SIZE_MB=5
PARKING_HOURLY_RATE_VND=10000.00

# ONNX Runtime CPU Execution & Thread Management (H4)
# ONNX_ALLOW_SPINNING=0 disables busy-waiting loops, avoiding 1000% CPU core starvation.
ONNX_INTRA_OP_THREADS=1
ONNX_INTER_OP_THREADS=1
ONNX_ALLOW_SPINNING=0

# ==============================================================================
# Observability & Data Privacy (Rule 07, J9)
# ==============================================================================
# Masks or salted-hashes full license plates in structured logs.
PARKING_LOG_PRIVACY_MODE=1
PARKING_LOG_MASK_PLATES=1

# CORS & CSRF Configuration (SPA Integration per ADR-0004)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production Security Flags (Optional Overrides for config/settings/production.py)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
