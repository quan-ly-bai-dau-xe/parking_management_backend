{
  "permission": {
    "bash": {
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git tag *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git restore *": "ask",
      "git reset *": "ask",
      "git branch -*d*": "ask",
      "git branch -*m*": "ask",
      "git branch --delete*": "ask",
      "git branch --move*": "ask",
      "git cherry-pick *": "ask",
      "git revert *": "ask",
      "git stash *": "ask",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -r *": "deny",
      "rm --recursive *": "deny",
      "git reset --hard*": "deny",
      "git clean *-f*": "deny",
      "git push -f*": "deny",
      "git push *--force*": "deny",
      "git push * -f*": "deny",
      "git branch -D*": "deny",
      "*--no-verify*": "deny",
      "*manage.py flush*": "deny",
      "*manage.py sqlflush*": "deny",
      "*manage.py dbshell*": "deny",
      "psql *DROP*": "deny",
      "psql *drop*": "deny",
      "psql *TRUNCATE*": "deny",
      "psql *truncate*": "deny",
      "docker *prune*": "deny"
    },
    "PowerShell": {
      "git add *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git tag *": "ask",
      "git checkout *": "ask",
      "git switch *": "ask",
      "git restore *": "ask",
      "git reset *": "ask",
      "git branch -*d*": "ask",
      "git branch -*m*": "ask",
      "git branch --delete*": "ask",
      "git branch --move*": "ask",
      "git cherry-pick *": "ask",
      "git revert *": "ask",
      "git stash *": "ask",
      "git reset --hard*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push *--force*": "deny",
      "git push * -f*": "deny",
      "git branch -D*": "deny",
      "git clean *-f*": "deny",
      "Remove-Item *-Recurse*": "deny",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "docker *prune*": "deny",
      "*manage.py flush*": "deny",
      "*manage.py sqlflush*": "deny",
      "*manage.py dbshell*": "deny",
      "psql *DROP*": "deny",
      "psql *TRUNCATE*": "deny",
      "*--no-verify*": "deny"
    },
    "read": {
      "*.env*": "deny",
      "!.env.example*": "deny",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/*.crt": "deny",
      "**/*.pfx": "deny",
      "**/*.p12": "deny",
      "**/*sonar*.txt": "deny"
    }
  }
}
