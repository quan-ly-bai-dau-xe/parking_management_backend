{
  "permissions": {
    "ask": [
      "PowerShell(git add *)",
      "PowerShell(git branch -*d*)",
      "PowerShell(git branch -*m*)",
      "PowerShell(git branch --delete*)",
      "PowerShell(git branch --move*)",
      "PowerShell(git checkout *)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git commit *)",
      "PowerShell(git merge *)",
      "PowerShell(git push *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset *)",
      "PowerShell(git restore *)",
      "PowerShell(git revert *)",
      "PowerShell(git stash *)",
      "PowerShell(git switch *)",
      "PowerShell(git tag *)",
      "command(git add)",
      "command(git checkout)",
      "command(git cherry-pick)",
      "command(git commit)",
      "command(git merge)",
      "command(git push)",
      "command(git rebase)",
      "command(git reset)",
      "command(git restore)",
      "command(git revert)",
      "command(git stash)",
      "command(git switch)",
      "command(git tag)",
      "command(regex:^git$ ^branch$ ^--delete.*$)",
      "command(regex:^git$ ^branch$ ^--move.*$)"
    ],
    "deny": [
      "PowerShell(*--no-verify*)",
      "PowerShell(*manage.py dbshell*)",
      "PowerShell(*manage.py flush*)",
      "PowerShell(*manage.py sqlflush*)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(docker *prune*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git clean *-f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(psql *DROP*)",
      "PowerShell(psql *TRUNCATE*)",
      "PowerShell(rm -fr *)",
      "PowerShell(rm -rf *)",
      "command(docker)",
      "command(git clean)",
      "command(git push)",
      "command(psql)",
      "command(regex:^git$ ^branch$ ^-D.*$)",
      "command(regex:^git$ ^push$ ^-f.*$)",
      "command(regex:^git$ ^reset$ ^--hard.*$)",
      "command(rm --recursive)",
      "command(rm -fr)",
      "command(rm -r)",
      "command(rm -rf)"
    ]
  }
}
