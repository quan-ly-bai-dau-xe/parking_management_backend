{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(*.env*)",
      "Read(!.env.example*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(**/*sonar*.txt)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(rm --recursive *)",
      "Bash(git reset --hard*)",
      "Bash(git clean *-f*)",
      "Bash(git push -f*)",
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(git branch -D*)",
      "Bash(*--no-verify*)",
      "Bash(*manage.py flush*)",
      "Bash(*manage.py sqlflush*)",
      "Bash(*manage.py dbshell*)",
      "Bash(psql *DROP*)",
      "Bash(psql *drop*)",
      "Bash(psql *TRUNCATE*)",
      "Bash(psql *truncate*)",
      "Bash(docker *prune*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git branch -D*)",
      "PowerShell(git clean *-f*)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(rm -rf *)",
      "PowerShell(rm -fr *)",
      "PowerShell(docker *prune*)",
      "PowerShell(*manage.py flush*)",
      "PowerShell(*manage.py sqlflush*)",
      "PowerShell(*manage.py dbshell*)",
      "PowerShell(psql *DROP*)",
      "PowerShell(psql *TRUNCATE*)",
      "PowerShell(*--no-verify*)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git tag *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git reset *)",
      "Bash(git branch -*d*)",
      "Bash(git branch -*m*)",
      "Bash(git branch --delete*)",
      "Bash(git branch --move*)",
      "Bash(git cherry-pick *)",
      "Bash(git revert *)",
      "Bash(git stash *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git tag *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git restore *)",
      "PowerShell(git reset *)",
      "PowerShell(git branch -*d*)",
      "PowerShell(git branch -*m*)",
      "PowerShell(git branch --delete*)",
      "PowerShell(git branch --move*)",
      "PowerShell(git cherry-pick *)",
      "PowerShell(git revert *)",
      "PowerShell(git stash *)"
    ]
  }
}
